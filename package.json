{
  "name": "ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "benchmark": "node --env-file-if-exists=.env --import tsx scripts/benchmark.ts",
    "retention": "node --env-file-if-exists=.env --import tsx scripts/retention.ts"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "pg": "^8.16.3",
    "ioredis": "^5.8.1",
    "kafkajs": "^2.2.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "playwright": "^1.56.1"
  }
}
