DATABASE_URL=postgresql://gateway:local-development-only@127.0.0.1:5432/gateway
REDIS_URL=redis://127.0.0.1:6379
# Set a random 32-byte hex key before first start; retain it securely for decrypting credentials.
ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=3000
ALLOW_PRIVATE_UPSTREAM=false
# Empty uses PostgreSQL outbox worker without Kafka.
KAFKA_BROKERS=
