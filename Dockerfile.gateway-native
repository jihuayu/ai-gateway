# Standalone Oracle GraalVM 25 Native Image Dockerfile for AI Gateway Netty Data Plane
# Build command:
#   docker build -f Dockerfile.gateway-native -t ai-gateway-netty:native .

# Stage 1: Oracle GraalVM 25 Native AOT Compilation
FROM container-registry.oracle.com/graalvm/native-image:25 AS builder
WORKDIR /workspace

RUN command -v mvn >/dev/null 2>&1 || ( \
    curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.tar.gz \
    | tar -xz -C /opt && ln -s /opt/apache-maven-3.9.9/bin/mvn /usr/local/bin/mvn )

COPY pom.xml ./
COPY src ./src

# Compile standalone zero-SQL Netty Gateway to native executable: target/ai-gateway-netty
RUN mvn -B -Pgateway-native -DskipTests native:compile

# Stage 2: Minimal Oracle Linux 9 Slim Runtime Image (100% glibc/zlib/CA ABI match with Oracle GraalVM 25 builder)
FROM container-registry.oracle.com/os/oraclelinux:9-slim
WORKDIR /app

COPY --from=builder /workspace/target/ai-gateway-netty /app/ai-gateway-netty

ENV HOST=0.0.0.0 \
    GATEWAY_PORT=3001 \
    REDIS_URL=redis://redis:6379 \
    DATA_PLANE_NAMESPACE=gateway \
    HOT_DURABILITY=aof \
    HOT_JOURNAL_CAPACITY=10000 \
    ALLOW_PRIVATE_UPSTREAM=false

EXPOSE 3001

ENTRYPOINT ["/app/ai-gateway-netty"]
