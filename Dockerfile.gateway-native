# Standalone Oracle GraalVM 25.5 (25i5) Native Image Dockerfile for AI Gateway Netty Data-Plane Cluster Node
# Build command:
#   docker build -f Dockerfile.gateway-native -t ai-gateway-netty:native .

FROM container-registry.oracle.com/graalvm/native-image:25i5 AS builder
WORKDIR /workspace

COPY gradlew settings.gradle.kts build.gradle.kts ./
COPY gradle ./gradle
COPY gateway-common ./gateway-common
COPY gateway-data-plane ./gateway-data-plane

RUN chmod +x ./gradlew && ./gradlew :gateway-data-plane:nativeCompile -x test --no-daemon

FROM container-registry.oracle.com/os/oraclelinux:9-slim
WORKDIR /app

COPY --from=builder /workspace/gateway-data-plane/build/native/nativeCompile/ai-gateway-netty /app/ai-gateway-netty

ENV HOST=0.0.0.0 \
    GATEWAY_PORT=3001 \
    REDIS_URL=redis://redis:6379 \
    DATA_PLANE_NAMESPACE=gateway \
    HOT_DURABILITY=aof \
    HOT_JOURNAL_CAPACITY=10000 \
    ALLOW_PRIVATE_UPSTREAM=false

EXPOSE 3001

ENTRYPOINT ["/app/ai-gateway-netty"]
